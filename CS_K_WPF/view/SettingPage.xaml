<Page
    x:Class="CS_K_WPF.view.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CS_K_WPF.view"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:CS_K_WPF.Model"
    Title="SettingPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{Binding SettingPageVm, Source={StaticResource ModelLocator}}"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  这种嵌套的只能利用WPF自己去找模板了，直接指定嵌套太麻烦  -->
        <HierarchicalDataTemplate DataType="{x:Type model:TreeViewYear}" ItemsSource="{Binding Months}">
            <TextBlock Text="{Binding Year}" />
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type model:TreeViewMonth}" ItemsSource="{Binding Days}">
            <TextBlock Text="{Binding Month}" />
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type model:TreeViewDay}" ItemsSource="{Binding Files}">
            <TextBlock Text="{Binding Day}" />
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type model:TreeViewLight}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                <Ellipse
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Fill="{Binding LightOne}" />
                <Ellipse
                    Grid.Column="2"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Fill="{Binding LightTwo}" />
            </Grid>
        </DataTemplate>



        <Style x:Key="subStyle" TargetType="{x:Type TreeViewItem}">
            <Style.Triggers>
                <!--  这行是关键，判断没有子项，也就是最里面一层  -->
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                <Border
                                    Name="BD"
                                    Margin="20,0,20,0"
                                    CornerRadius="30">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="BD" Property="Background" Value="DarkCyan" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                </Trigger>

            </Style.Triggers>
        </Style>



    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  多层次的树形结构  -->
        <Grid Grid.Column="1">
            <TreeView
                FontSize="24"
                ItemContainerStyle="{StaticResource subStyle}"
                ItemsSource="{Binding TreeViewYeads}" />
        </Grid>

        <!--  这种属于递归结构树形结构  -->
        <Grid Grid.Column="0">
            <TreeView ItemsSource="{Binding TestClassCollections}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock FontSize="32" Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>

            </TreeView>
        </Grid>

    </Grid>
</Page>
