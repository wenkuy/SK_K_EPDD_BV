<Page
    x:Class="CS_K_WPF.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CS_K_WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="HomePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--  首页  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!--  生产中  -->
                <StackPanel Grid.Column="0">
                    <Grid>
                        <Border Background="LightGray" />
                        <TextBlock Text="生产中" />
                    </Grid>

                    <DataGrid>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="机型" />
                            <DataGridTextColumn x:Name="产品类型" />
                            <DataGridTextColumn x:Name="已生产" />
                            <DataGridTextColumn x:Name="良率" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!--  停生产  -->
                <StackPanel Grid.Column="1">
                    <Grid>
                        <Border Background="LightGray" />
                        <TextBlock Text="生产中" />
                    </Grid>

                    <DataGrid>
                        <DataGrid.Columns>
                            <DataGridTextColumn />
                            <DataGridTextColumn />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>

            <!--  生产记录  -->
            <StackPanel Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Name="背景条" Background="LightGray" />
                    <TextBlock Grid.Column="1" Text="时间" />
                    <TextBlock Grid.Column="2" Text="总产量" />
                    <TextBlock Grid.Column="3" Text="总合格率" />
                    <TextBlock Grid.Column="4" Text="故障率" />
                </Grid>
                <DataGrid>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="时间" />
                        <DataGridTextColumn x:Name="总产量" />
                        <DataGridTextColumn x:Name="总合格率" />
                        <DataGridTextColumn x:Name="故障率" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

        </Grid>

    </Grid>
</Page>
