<Page
    x:Class="CS_K_WPF.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CS_K_WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="HomePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{Binding Source={StaticResource ModelLocator}, Path=LocHomePageVM}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>



        <!--  首页  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!--  生产中  -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Grid>
                        <Border Background="LightGray" />
                        <TextBlock Text="生产中" />
                    </Grid>

                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="None"
                        IsReadOnly="True"
                        ItemsSource="{Binding Products}"
                        SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Path=EmployeeId}"
                                Header="机型" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Path=ProductNumber}"
                                Header="产品类型" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Path=Param.Temperature}"
                                Header="温度" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Path=Param.Humidity}"
                                Header="湿度" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!--  停生产  -->
                <StackPanel Grid.Column="1">
                    <Grid>
                        <Border Background="LightGray" />
                        <TextBlock Text="设备状态" />
                    </Grid>

                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="None"
                        IsReadOnly="True"
                        ItemsSource="{Binding EquipmentStateRecordsCollections}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Path=EquipmentNumber}"
                                Header="设备编号" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Path=EquipmentState}"
                                Header="设备状态" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>

            <!--  生产记录  -->
            <StackPanel Grid.Row="1">
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Header="时间" />
                        <DataGridTextColumn Width="*" Header="总产量" />
                        <DataGridTextColumn Width="*" Header="总合格率" />
                        <DataGridTextColumn Width="*" Header="故障率" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

        </Grid>

    </Grid>
</Page>
