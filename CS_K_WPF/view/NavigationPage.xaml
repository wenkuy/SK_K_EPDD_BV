                    Height="80"
                    Content="实时监控"
                    FontSize="30" />
                <Button
                    Height="80"
                    Content="生产设备"
                    FontSize="30" />
                <Button
                    Height="80"
                    Content="用户管理"
                    FontSize="30" />
                <Button
                    Height="80"
                    Content="系统设置"
                    FontSize="30" />
            </StackPanel>
        </Border>
    </Grid>
