<Window
    x:Class="CS_K_WPF.view.EditUserWnd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CS_K_WPF.view"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EditUserWnd"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <UniformGrid Grid.Row="1" Columns="4">
            <TextBlock Text="员工编号" />
            <TextBox />
            <TextBlock Text="员工姓名" />
            <TextBox />
        </UniformGrid>
        <UniformGrid Grid.Row="2" Columns="4">
            <TextBlock Text="员工账号" />
            <TextBox />
            <TextBlock Text="员工密码" />
            <TextBox />
        </UniformGrid>

        <UniformGrid Grid.Row="7">
            <Button Content="确认" />
            <Button Content="取消" />
        </UniformGrid>
        <TextBox />

    </Grid>

</Window>
