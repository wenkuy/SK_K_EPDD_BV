<Window
    x:Class="CS_K_WPF.view.EditEquipmentWnd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CS_K_WPF.view"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EditEquipmentWnd"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <UniformGrid Grid.Row="1" Columns="4">
            <TextBlock Text="型号" />
            <TextBox />
            <TextBlock Text="昵称" />
            <TextBox />
        </UniformGrid>
        <UniformGrid Grid.Row="2" Columns="4">
            <TextBlock Text="购买日期" />
            <TextBox />
            <TextBlock Text="服务年限" />
            <TextBox />
        </UniformGrid>
       
        <!--<UniformGrid Grid.Row="3" Columns="4">
            <TextBlock Text="产地" />
            <TextBox />
            <TextBlock />
            <Border />
        </UniformGrid>-->
        <UniformGrid Grid.Row="4" Columns="4">
            <TextBlock Text="IP" />
            <TextBox />
            <TextBlock Text="Port" />
            <TextBox />
        </UniformGrid>
        <UniformGrid Grid.Row="7">
            <Button Content="确认" />
            <Button Content="取消" />
        </UniformGrid>
        <TextBox />

    </Grid>
</Window>
