<Application
    x:Class="CS_K_WPF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CS_K_WPF"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--<local:ModelLocator x:Key="ModelLocator" />--><!--  这个会创建实例，导致报错，因为为了安全把构造给私有化了-->
            <ObjectDataProvider x:Key="ModelLocator" ObjectInstance="{x:Static local:ModelLocator.Instance}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
