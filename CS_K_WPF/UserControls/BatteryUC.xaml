<UserControl
    x:Class="CS_K_WPF.UserControls.BatteryUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CS_K_WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="batteryUc"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Rectangle
            Width="{Binding Width, ElementName=batteryUc}"
            Height="{Binding Height, ElementName=batteryUc}"
            StrokeThickness="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="White" />
                    <GradientStop Offset="0.5" Color="Gray" />
                    <GradientStop Offset="1" Color="White" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--  Fill="{Binding Background, ElementName=batteryUc}  -->
        <Rectangle Width="{Binding Width, ElementName=batteryUc}" Height="{Binding Height, ElementName=batteryUc}">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="White" />
                    <GradientStop Offset="0.5" Color="{Binding BatteryColor, ElementName=batteryUc}" />
                    <GradientStop Offset="1" Color="White" />
                </LinearGradientBrush>
            </Rectangle.Fill>

            <Rectangle.RenderTransformOrigin>
                <Point X="0" Y="1" />
            </Rectangle.RenderTransformOrigin>
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleY="{Binding Electricity, ElementName=batteryUc}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <StackPanel>
            <TextBlock Text="电量：" />
            <TextBlock Text="{Binding Electricity, ElementName=batteryUc}" />
            <TextBlock Text="{Binding Electricity, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:BatteryUC}}}" />

            <TextBlock Text="温度：" />
            <TextBlock Text="{Binding Temperature, ElementName=batteryUc}" />
        </StackPanel>

    </Grid>
</UserControl>
