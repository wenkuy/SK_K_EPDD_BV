<Window
    x:Class="DataAnalasisProj.View.DataAnalysisWnd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dockablz="http://dragablz.net/winfx/xaml/dockablz"
    xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
    xmlns:local="clr-namespace:DataAnalasisProj.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DataAnalysisWnd"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>

        <dragablz:InterTabController x:Key="TabController" Partition="2AE89D18-F236-4D20-9605-6C03319038E6" />
        <!--  2. 主标签控件样式（简化版）  -->
        <Style x:Key="TabStyle" TargetType="{x:Type dragablz:TabablzControl}">
            <Setter Property="InterTabController" Value="{StaticResource TabController}" />
            <Setter Property="ItemsSource" Value="{Binding Items}" />
            <Setter Property="ShowDefaultCloseButton" Value="True" />
        </Style>
        <DataTemplate x:Key="FloatItemTemplate">
            <!--  直接渲染HeaderedItemViewModel的Content（即CartesianChart）  -->
            <ContentControl
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Content="{Binding Content}" />
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="25*" />
            <!--  数据分析  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  所有表的总控轴  -->
        <Grid Grid.Row="1">
            <!--  总进度条  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="150"
                    Height="45"
                    HorizontalAlignment="Left"
                    Click="AddChartButton_Click"
                    Content="新建表格" />
                <Slider Grid.Column="1" />
            </Grid>
        </Grid>

        <!--  数据分析区  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#383838">
                <!--  图表控件  -->
                <dockablz:Layout
                    x:Name="DragLyout"
                    FloatingItemTemplate="{StaticResource FloatItemTemplate}"
                    IsFloatDropZoneEnabled="True"
                    Partition="2AE89D18-F236-4D20-9605-6C03319038E6">
                    <dragablz:TabablzControl
                        x:Name="DragControl"
                        FixedHeaderCount="1"
                        Style="{StaticResource TabStyle}" />
                </dockablz:Layout>
            </Grid>

            <Grid Grid.Column="1">
                <!--  图标操作区  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Button
                        Click="AddSeriesButton_Click"
                        Content="添加曲线"
                        FontSize="20" />
                    <Button
                        Click="DeleteSeriesButton_Click"
                        Content="删除曲线"
                        FontSize="20" />
                </StackPanel>
                <TabControl Name="TabCtrl" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>
