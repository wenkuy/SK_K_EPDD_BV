<Window
    x:Class="DataAnalasisProj.View.DataAnalysisWnd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dockablz="http://dragablz.net/winfx/xaml/dockablz"
    xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
    xmlns:local="clr-namespace:DataAnalasisProj.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    Title="DataAnalysisWnd"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="25*" />
            <!--  数据分析  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  所有表的总控轴  -->
        <Grid Grid.Row="1">
            <!--  总进度条  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="150"
                    Height="45"
                    HorizontalAlignment="Left"
                    Click="AddChartButton_Click"
                    Content="新建表格" />
                <Button
                    Grid.Column="1"
                    Command="{x:Static dockablz:Layout.TileFloatingItemsCommand}"
                    CommandTarget="{Binding ElementName=DragLyout}">
                    Tile Grid
                </Button>
                <Button
                    Grid.Column="2"
                    Command="{x:Static dockablz:Layout.TileFloatingItemsVerticallyCommand}"
                    CommandTarget="{Binding ElementName=DragLyout}">
                    Tile Horizontal
                </Button>
                <Button
                    Grid.Column="3"
                    Command="{x:Static dockablz:Layout.TileFloatingItemsHorizontallyCommand}"
                    CommandTarget="{Binding ElementName=DragLyout}">
                    Tile Vertical
                </Button>

                <!--  滑块  -->
                <Slider Grid.Column="4" />
            </Grid>
        </Grid>

        <!--  数据分析区  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="MyGrid"
                Grid.Column="0"
                Background="#383838">
                <!--  图表控件  -->
                <dockablz:Layout
                    x:Name="DragLyout"
                    FloatingItemDisplayMemberPath="SimpleContent"
                    FloatingItemHeaderMemberPath="Name" />
            </Grid>

            <Grid Grid.Column="1">
                <!--  图标操作区  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Button
                        Click="AddSeriesButton_Click"
                        Content="添加曲线"
                        FontSize="20" />
                    <Button
                        Click="DeleteSeriesButton_Click"
                        Content="删除曲线"
                        FontSize="20" />
                </StackPanel>
                <TabControl Name="TabCtrl" Grid.Row="1" />

                <!--<wpf:CartesianChart
                     x:Name="MyChart"
                    Grid.Row="1"
                    SeriesSource="{Binding Data}">
                    <wpf:CartesianChart.XAxes>
                        <wpf:AxesCollection>
                            <wpf:XamlAxis Labels="{Binding Labels}"/>
                        </wpf:AxesCollection>
                    </wpf:CartesianChart.XAxes>
                </wpf:CartesianChart>-->

            </Grid>
        </Grid>
    </Grid>
</Window>
